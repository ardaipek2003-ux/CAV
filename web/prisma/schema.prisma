generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now()) @map("created_at")
  orders       Order[]

  @@map("users")
}

enum Role {
  BUYER
  ADMIN
}

// ─── Spot (physical facility) ───────────────────────────────────────────────

model Spot {
  id               String     @id @default(uuid())
  moduleNumber     Int        @map("module_number")
  rowNumber        Int        @map("row_number")
  spotNumber       Int        @map("spot_number")
  growthMultiplier Float      @map("growth_multiplier")
  status           SpotStatus @default(EMPTY)
  plantId          String?    @unique @map("plant_id")
  plant            Plant?     @relation("SpotPlant", fields: [plantId], references: [id])

  robotJobsFrom RobotJob[] @relation("FromSpot")
  robotJobsTo   RobotJob[] @relation("ToSpot")

  @@unique([moduleNumber, rowNumber, spotNumber])
  @@index([status])
  @@index([moduleNumber])
  @@map("spots")
}

enum SpotStatus {
  EMPTY
  OCCUPIED
  RESERVED
  IN_TRANSIT
}

// ─── Plant ──────────────────────────────────────────────────────────────────

model Plant {
  id              String      @id @default(uuid())
  orderId         String      @map("order_id")
  order           Order       @relation(fields: [orderId], references: [id])
  cropType        CropType    @map("crop_type")
  spotId          String?     @map("spot_id")
  spot            Spot?       @relation("SpotPlant")
  plantedAt       DateTime    @default(now()) @map("planted_at")
  expectedHarvest DateTime    @map("expected_harvest")
  status          PlantStatus @default(PLANTED)
  relocatedFrom   String?     @map("relocated_from")

  robotJobs RobotJob[]

  @@index([orderId])
  @@map("plants")
}

enum CropType {
  LETTUCE
  TOMATO
}

enum PlantStatus {
  PLANTED
  IN_TRANSIT
  HARVESTED
}

// ─── Order ──────────────────────────────────────────────────────────────────

model Order {
  id             String      @id @default(uuid())
  buyerId        String      @map("buyer_id")
  buyer          User        @relation(fields: [buyerId], references: [id])
  cropType       CropType    @map("crop_type")
  quantityKg     Float       @map("quantity_kg")
  spotsNeeded    Int         @map("spots_needed")
  status         OrderStatus @default(PENDING)
  quotedHarvest  DateTime?   @map("quoted_harvest")
  actualHarvest  DateTime?   @map("actual_harvest")
  confirmedAt    DateTime?   @map("confirmed_at")
  deliveredAt    DateTime?   @map("delivered_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  plants         Plant[]

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  GROWING
  HARVESTED
  DELIVERED
  NEEDS_ATTENTION
}

// ─── Robot Job ──────────────────────────────────────────────────────────────

model RobotJob {
  id          String       @id @default(uuid())
  jobType     JobType      @map("job_type")
  plantId     String       @map("plant_id")
  plant       Plant        @relation(fields: [plantId], references: [id])
  fromSpotId  String?      @map("from_spot_id")
  fromSpot    Spot?        @relation("FromSpot", fields: [fromSpotId], references: [id])
  toSpotId    String       @map("to_spot_id")
  toSpot      Spot         @relation("ToSpot", fields: [toSpotId], references: [id])
  priority    Int          @default(2)
  status      RobotJobStatus @default(QUEUED)
  queuedAt    DateTime     @default(now()) @map("queued_at")
  completedAt DateTime?    @map("completed_at")

  @@index([status])
  @@map("robot_jobs")
}

enum JobType {
  PLANT
  RELOCATE
  HARVEST
}

enum RobotJobStatus {
  QUEUED
  IN_PROGRESS
  DONE
  FAILED
}
